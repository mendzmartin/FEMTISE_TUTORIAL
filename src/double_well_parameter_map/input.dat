L                           = 8.0
Δx                          = 0.02
## ONLY FOR 2D EIGENPROBLEMS
Lx                          =
Ly                          =
nx                          =
ny                          =
different_masses            =
reduced_density             =
## OPTIONAL SETTINGS (FEMTISE v0.2.0)
analysis_param_2            = 2 -0.05 1.0 0.05
quadrature_degree           = 8
